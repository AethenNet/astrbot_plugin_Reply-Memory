{
  "active_reply": {
    "description": "消息主动回复",
    "hint": "主动回复群聊中的用户消息。开启「群聊回复增强 -> React Pattern」后可获得更完整的上下文与智能 @ 效果",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "hint": "开启后 Bot 会在群聊中自行判断是否回复，无需被 @",
        "type": "bool",
        "default": false
      },
      "mode": {
        "description": "回复方式",
        "hint": "probability：按概率回复；model_choice：由模型判定是否回复",
        "type": "string",
        "options": [
          "probability",
          "model_choice"
        ],
        "labels": [
          "概率",
          "模型判定"
        ],
        "default": "probability"
      },
      "possibility": {
        "description": "回复概率",
        "hint": "当回复方式选择为 probability 时显示。每条消息按该概率触发一次主动回复",
        "type": "float",
        "slider": {
          "min": 0.05,
          "max": 1,
          "step": 0.01
        },
        "condition": {
          "mode": "probability"
        },
        "default": 0.1
      },
      "model_history_messages": {
        "description": "模型判定消息附带",
        "hint": "当回复方式选择为 model_choice 时显示。判定时附带的额外历史消息条数（0 表示不附带额外消息）",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "condition": {
          "mode": "model_choice"
        },
        "default": 0
      },
      "model_choice_provider_id": {
        "description": "模型判定提供商",
        "hint": "当回复方式选择为 model_choice 时显示。用于“是否主动回复”判定，留空使用当前会话默认提供商",
        "type": "string",
        "_special": "select_provider",
        "condition": {
          "mode": "model_choice"
        },
        "default": ""
      },
      "trigger_threshold": {
        "description": "回复触发积累",
        "hint": "累计的消息到达该条数后触发一次强制回复或模型判定，随后清空积累。probability 模式下若连续未回复条数达到该值则强制回复一次",
        "type": "int",
        "slider": {
          "min": 2,
          "max": 50,
          "step": 1
        },
        "default": 10
      },
      "list_mode": {
        "description": "禁用名单",
        "hint": "选择使用黑名单还是白名单来控制主动回复生效的群",
        "type": "string",
        "options": [
          "blacklist",
          "whitelist"
        ],
        "labels": [
          "黑名单",
          "白名单"
        ],
        "default": "blacklist"
      },
      "blacklist": {
        "description": "黑名单",
        "hint": "填写 QQ 群号，主动回复功能不会在这些群内生效",
        "type": "list",
        "condition": {
          "list_mode": "blacklist"
        },
        "default": []
      },
      "whitelist": {
        "description": "白名单",
        "hint": "填写 QQ 群号，主动回复功能只会在这些群内生效",
        "type": "list",
        "condition": {
          "list_mode": "whitelist"
        },
        "default": []
      }
    }
  },
  "group_context_enhancement": {
    "description": "群聊上下文增强",
    "hint": "以增强格式记录群聊消息并注入 LLM 上下文，为主动回复与智能回复提供依据",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "hint": "开启后记录群聊历史并在对话时注入，建议关闭 AstrBot 内置的群聊上下文感知以避免重复注入",
        "type": "bool",
        "default": true
      },
      "max_messages": {
        "description": "会话消息上限",
        "hint": "每个会话保留的最大历史消息条数，超出后丢弃最早的消息；每轮都会注入，过大将显著增加 token 与延迟",
        "type": "int",
        "slider": {
          "min": 10,
          "max": 1000,
          "step": 10
        },
        "default": 200
      },
      "history_max_chars": {
        "description": "历史字数上限",
        "hint": "注入模型的群聊历史总字数上限，超出时从最早的消息开始丢弃",
        "type": "int",
        "slider": {
          "min": 500,
          "max": 20000,
          "step": 500
        },
        "default": 5000
      },
      "include_sender_id": {
        "description": "包含用户信息",
        "hint": "在历史消息格式中写入发送者用户 ID，智能回复 @ 用户时依赖该 ID",
        "type": "bool",
        "default": true
      },
      "include_role_tag": {
        "description": "包含标签",
        "hint": "在历史消息格式中写入 admin/member 角色标记（基于 AstrBot 管理员列表）",
        "type": "bool",
        "default": true
      },
      "image_caption": {
        "description": "图片转述",
        "hint": "启用图片转述能力。历史默认写入 [Image]，模型可通过工具按需补全描述",
        "type": "bool",
        "default": false
      },
      "image_caption_provider_id": {
        "description": "图片转述提供商",
        "hint": "用于图片转述的 LLM 提供商 ID，留空使用默认提供商",
        "type": "string",
        "_special": "select_provider",
        "default": ""
      },
      "image_caption_prompt": {
        "description": "图片转述文本",
        "hint": "发送给图片转述模型的提示词",
        "type": "text",
        "default": "Please describe the image using Chinese."
      }
    }
  },
  "group_reply_enhancement": {
    "description": "群聊回复增强",
    "hint": "React Pattern 开启后，群聊上下文与回复增强会加强主动回复能力；关闭时本区块不生效",
    "type": "object",
    "items": {
      "react_pattern": {
        "description": "React Pattern",
        "hint": "开启后群聊上下文增强与群聊回复增强会以 React 方式加强主动回复能力，关闭不影响主动回复",
        "type": "bool",
        "default": true
      },
      "role_display": {
        "description": "用户角色显示",
        "hint": "在 system_reminder 中注入用户角色（admin/member），需开启 AstrBot 内置用户识别",
        "type": "bool",
        "default": true
      },
      "smart_reply": {
        "description": "智能回复",
        "hint": "开启后 LLM 会根据需求引用对应消息并在回复中 @ 相关用户，解析 <mention id=\"用户ID\"/> 与 <quote id=\"消息ID\"/> 并转换为平台消息组件",
        "type": "bool",
        "default": true
      },
      "user_block": {
        "description": "用户屏蔽",
        "hint": "作用于全局：列表中的用户消息会被直接忽略。群级单独屏蔽可在插件页面「屏蔽设置」中配置",
        "type": "object",
        "items": {
          "enable": {
            "description": "启用",
            "hint": "关闭后整个用户屏蔽区块不生效（页面与指令添加的记录仍会保留）",
            "type": "bool",
            "default": true
          },
          "blacklist": {
            "description": "用户黑名单",
            "hint": "填写 QQ 号，列表内用户的消息会被直接忽略；默认屏蔽 AstrBot 内置的 4 个官方/管家账号（2854196310、2854197266、3889239358、3889001246），留空表示不额外屏蔽",
            "type": "list",
            "default": [
              "2854196310",
              "2854197266",
              "3889239358",
              "3889001246"
            ]
          },
          "block_hint": {
            "description": "屏蔽提示",
            "hint": "开启后被屏蔽的用户 @ 机器人或使用指令时，插件会回复一条被屏蔽提示",
            "type": "bool",
            "default": false
          }
        }
      }
    }
  },
  "web_search": {
    "description": "联网搜索",
    "hint": "为模型提供 grok_web_search 工具，用于实时检索外部信息。仅使用指定 provider，不跟随当前会话 provider",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用",
        "hint": "开启后注册并允许调用 grok_web_search",
        "type": "bool",
        "default": false
      },
      "provider_id": {
        "description": "搜索提供商 ID",
        "hint": "用于执行联网搜索的 provider ID，留空时工具会报错并拒绝调用",
        "type": "string",
        "_special": "select_provider",
        "default": ""
      },
      "system_prompt": {
        "description": "搜索系统提示词",
        "hint": "用于约束搜索结果输出格式（默认要求返回 JSON）",
        "type": "text",
        "default": "You are a web research assistant. Use live web search/browsing when answering. Return ONLY a single JSON object with keys: content (string), sources (array of objects with url/title/snippet when possible). Keep content concise and evidence-backed. IMPORTANT: Do NOT use Markdown formatting in the content field - use plain text only."
      },
      "timeout_sec": {
        "description": "搜索超时(秒)",
        "hint": "单次搜索调用最大等待时间",
        "type": "float",
        "slider": {
          "min": 30,
          "max": 180,
          "step": 5
        },
        "default": 60
      },
      "request_mode": {
        "description": "请求模式",
        "hint": "auto 模式会先尝试 responses，失败后回退 chat_completions",
        "type": "string",
        "options": [
          "auto",
          "responses",
          "chat_completions"
        ],
        "labels": [
          "自动",
          "Responses",
          "Chat Completions"
        ],
        "default": "auto"
      },
      "base_url_override": {
        "description": "Base URL 覆盖",
        "hint": "可选。留空时使用 provider 的 api_base；填写后仅 grok_web_search 使用该 base",
        "type": "string",
        "default": ""
      },
      "show_sources": {
        "description": "输出来源",
        "hint": "开启后在工具返回中附带来源 URL",
        "type": "bool",
        "default": false
      },
      "max_sources": {
        "description": "最多来源条数",
        "hint": "show_sources=true 时生效",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        },
        "default": 5
      }
    }
  },
  "memory_rag": {
    "description": "记忆 RAG",
    "hint": "供 LLM Tool 使用的可检索记忆库，支持 embedding 召回与时间/角色/群聊过滤",
    "type": "object",
    "items": {
      "memory_control": {
        "description": "记忆控制",
        "hint": "记忆 RAG 总开关；关闭后本区块所有选项均不生效",
        "type": "object",
        "items": {
          "enable": {
            "description": "启用",
            "hint": "记忆 RAG 总开关，默认关闭；开启后记忆生成、注入与评估才会运行",
            "type": "bool",
            "default": false
          },
          "embedding_provider_id": {
            "description": "Embedding Provider ID",
            "hint": "用于记忆向量化的 Embedding 提供商，留空时自动使用第一个可用的 embedding provider",
            "type": "string",
            "default": "",
            "_special": "select_provider:embedding"
          },
          "auto_extract_provider_id": {
            "description": "记忆抽取模型",
            "hint": "用于后台记忆抽取的对话模型，留空时跟随当前会话模型；建议选便宜的小模型",
            "type": "string",
            "default": "",
            "_special": "select_provider"
          },
          "cross_group_personal": {
            "description": "跨群仅本人记忆",
            "hint": "开启后，别的群/全局记忆只有你参与过才会被召回；关闭则只在当前群内检索",
            "type": "bool",
            "default": true
          },
          "cross_group_private": {
            "description": "私聊记忆可跨群",
            "hint": "开启后，你参与过的私聊记忆也可能出现在群里；默认关闭，避免私聊内容外泄",
            "type": "bool",
            "default": false
          }
        }
      },
      "memory_generation": {
        "description": "记忆生成",
        "hint": "控制自动记忆的触发、频率与过滤阈值",
        "type": "object",
        "items": {
          "auto_extract_enable": {
            "description": "自动产生记忆",
            "hint": "开启后关键词与后台抽取会自动写入记忆",
            "type": "bool",
            "default": true
          },
          "memory_batch_messages": {
            "description": "累计消息记忆",
            "hint": "未总结消息达到该条数、且抽取间隔冷却结束后，把积压的消息一次性总结；空档期由“对话间隔切窗”兜底",
            "type": "int",
            "slider": {
              "min": 10,
              "max": 100,
              "step": 1
            },
            "default": 50
          },
          "auto_extract_interval_minutes": {
            "description": "抽取间隔（分钟）",
            "hint": "两次抽取之间的最小间隔",
            "type": "int",
            "slider": {
              "min": 1,
              "max": 120,
              "step": 1
            },
            "default": 10
          },
          "private_extract_every_n": {
            "description": "私聊抽取频率（条）",
            "hint": "与机器人私聊时每累计多少条消息总结一次",
            "type": "int",
            "slider": {
              "min": 3,
              "max": 100,
              "step": 1
            },
            "default": 10
          },
          "auto_extract_min_confidence": {
            "description": "最低置信度",
            "hint": "低于该值的候选记忆会被丢弃；按五档标准，日常讨论通常为 0.50-0.60，简单闲聊为 0.30-0.40。默认 0.50 可保留日常讨论，只过滤闲聊以下",
            "type": "float",
            "slider": {
              "min": 0,
              "max": 1,
              "step": 0.05
            },
            "default": 0.5
          },
          "auto_extract_scope": {
            "description": "记忆作用域",
            "hint": "自动：本群 + 全局 + 本人参与过的跨群记忆；仅全局：只查全局层（仍限本人参与）；仅本群：严格隔离",
            "type": "string",
            "options": [
              "group_first",
              "global",
              "group"
            ],
            "labels": [
              "自动",
              "仅全局",
              "仅本群"
            ],
            "default": "group_first"
          },
          "memory_extract_max_chars": {
            "description": "抽取输入字数上限",
            "hint": "单次送入模型的最大字数；5000 字约等于 50 条短消息，积压超过上限时会从最早开始连续分几次总结，不丢消息",
            "type": "int",
            "slider": {
              "min": 500,
              "max": 10000,
              "step": 250
            },
            "default": 6000
          },
          "memory_extract_min_substance_chars": {
            "description": "无实质内容过滤字数",
            "hint": "整窗去掉图片/表情/引用/链接后，实质文字（中日韩文字、字母、数字）少于该值时跳过抽取，避免只有图片和表情的窗口生成记忆；0 表示关闭",
            "type": "int",
            "slider": {
              "min": 0,
              "max": 100,
              "step": 1
            },
            "default": 8
          },
          "memory_max_participants": {
            "description": "单条记忆参与者上限",
            "hint": "一条记忆最多关联多少名窗口内的真实发言者；多人窗口会依次按模型结论、昵称、证据与发言顺序补齐参与者",
            "type": "int",
            "slider": {
              "min": 1,
              "max": 30,
              "step": 1
            },
            "default": 10
          },
          "memory_multi_atom": {
            "description": "多条原子记忆",
            "hint": "开启后一次抽取可产出 1-3 条独立记忆（各自带类型、实体、有效期），记忆更准但写入条数更多",
            "type": "bool",
            "default": true
          },
          "memory_atom_max_items": {
            "description": "单次最多条数",
            "hint": "开启多条原子记忆时，单个对话窗口最多写入几条",
            "type": "int",
            "slider": {
              "min": 1,
              "max": 5,
              "step": 1
            },
            "default": 3
          }
        }
      },
      "memory_injection": {
        "description": "记忆注入",
        "hint": "控制自动回忆注入给模型的内容规模",
        "type": "object",
        "items": {
          "memory_inject_max_chars": {
            "description": "注入字数上限",
            "hint": "自动回忆注入给模型的总字数上限（默认 1500 字）",
            "type": "int",
            "slider": {
              "min": 500,
              "max": 5000,
              "step": 100
            },
            "default": 1500
          },
          "memory_inject_max_items": {
            "description": "注入条数上限",
            "hint": "自动回忆最多注入多少条记忆，0 表示不注入",
            "type": "int",
            "slider": {
              "min": 0,
              "max": 15,
              "step": 1
            },
            "default": 5
          }
        }
      },
      "memory_evaluation": {
        "description": "记忆评估",
        "hint": "控制记忆的时间衰减、定期巩固与低价值归档",
        "type": "object",
        "items": {
          "memory_consolidation_enable": {
            "description": "定期巩固",
            "hint": "定期把同主题的多条旧记忆合并成一条摘要",
            "type": "bool",
            "default": true
          },
          "memory_consolidation_interval_days": {
            "description": "巩固间隔（天）",
            "hint": "两次巩固之间的最小间隔",
            "type": "int",
            "slider": {
              "min": 1,
              "max": 30,
              "step": 1
            },
            "default": 7
          },
          "memory_consolidation_archive": {
            "description": "巩固仅归档",
            "hint": "开启后巩固只把被合并的旧记忆移入归档，不直接删除；关闭时按旧行为处理",
            "type": "bool",
            "default": true
          },
          "memory_trash_retention_days": {
            "description": "回收站保留天数",
            "hint": "删除的记忆在回收站中保留多少天，超期后物理清理（归档记录不在回收站）",
            "type": "int",
            "slider": {
              "min": 7,
              "max": 365,
              "step": 1
            },
            "default": 30
          },
          "memory_archive_enable": {
            "description": "归档低价值记忆",
            "hint": "低重要性且长期未访问的记忆会被归档，不再参与检索",
            "type": "bool",
            "default": true
          },
          "memory_archive_days": {
            "description": "归档天数",
            "hint": "超过多少天未访问且重要性低的记忆会被归档",
            "type": "int",
            "slider": {
              "min": 7,
              "max": 120,
              "step": 1
            },
            "default": 30
          },
          "memory_archive_importance": {
            "description": "归档重要性阈值",
            "hint": "有效重要性低于该值的记忆才可能被归档（0-10；开启重要性演化时按查询时刻计算）",
            "type": "float",
            "slider": {
              "min": 0.0,
              "max": 10.0,
              "step": 0.5
            },
            "default": 3.5
          },
          "memory_ttl_adaptive": {
            "description": "自适应有效期",
            "hint": "写入记忆时按「类型基础天数 × 重要性系数 × 强化系数」计算有效期；关闭后不再写有效期，改用旧的按类型硬过期策略",
            "type": "bool",
            "default": true
          },
          "memory_ttl_base": {
            "description": "按类型基础有效期（天）",
            "hint": "每条记忆按类型的基础有效期，单位天，范围 1–365；重要性和访问次数会在此基础上延长。计划/事件可短一些，事实/关系可长一些。",
            "type": "object",
            "items": {
              "plan_days": {
                "description": "计划·基础天数",
                "type": "int",
                "slider": {
                  "min": 0,
                  "max": 365,
                  "step": 1
                },
                "default": 2,
                "hint": "0 表示该类型永不过期；其余数值为基础天数，范围 0–365，重要性和访问次数会在此基础上延长。"
              },
              "episode_days": {
                "description": "事件·基础天数",
                "type": "int",
                "slider": {
                  "min": 0,
                  "max": 365,
                  "step": 1
                },
